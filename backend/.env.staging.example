# VolleyVision STAGING — local environment for staging tooling
#
# Copy to backend/.env.staging (gitignored) and fill in; docs/staging-setup.md
# walks through it. Used by (from the repo root):
#   - .\deploy.ps1 -Target staging           (migrate status, --site, smoke check)
#   - .\deploy.ps1 -Target staging -Migrate  (prisma migrate deploy against staging)
#   - .\deploy.ps1 -Target staging -Seed     (npm run db:seed:staging)
# Never point any of these at the production project. Never commit the real file.

# ─── Staging Supabase database ────────────────────────────────────────────────
# Session pooler (port 5432, Sydney), the same string Fly uses: no pgbouncer=true.
# Copy the host from Supabase > Connect > Session pooler (aws-0-... or aws-1-...).
DATABASE_URL="postgresql://postgres.<staging-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?connection_limit=8"
# Same session pooler string, used for migrations (the direct host is IPv6-only on Free).
DIRECT_URL="postgresql://postgres.<staging-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres"
# Attachment storage; also read by scripts/copy-storage.ts --env-file.
SUPABASE_URL=https://<staging-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The staging project ref. seed-staging.ts refuses any DATABASE_URL that
# doesn't contain it (and any that contains the prod ref).
STAGING_PROJECT_REF=<staging-ref>

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Password for every seed login (staging+<role>@volleyvision.test). 12+ chars.
SEED_PASSWORD=
# Optional (9.11): the store reviewers' demo login on staging; defaults to
# staging+reviewer@volleyvision.test. It owns "Demo Volleyball Club".
REVIEWER_EMAIL=

# ─── Netlify staging site ─────────────────────────────────────────────────────
NETLIFY_STAGING_SITE_ID=
STAGING_URL=https://volleyvision-staging.netlify.app

# ─── Smoke check (backend/scripts/smoke.mjs) ──────────────────────────────────
SMOKE_EMAIL=staging+owner@volleyvision.test
SMOKE_PASSWORD=
SMOKE_OUTSIDER_EMAIL=staging+outsider@volleyvision.test
SMOKE_OUTSIDER_PASSWORD=
# Printed by `npm run db:seed:staging`.
SMOKE_TEAM_ID=staging-falcons
SMOKE_MATCH_ID=staging-falcons-m1
